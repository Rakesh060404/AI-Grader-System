{
  "name": "@ai-grader/grader",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/worker.js",
    "test": "npm run build --workspace=@ai-grader/shared && npm run build && node --env-file-if-exists=../../.env --test test/gradeProcessing.test.mjs"
  },
  "dependencies": {
    "@ai-grader/shared": "^1.0.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "pdf-to-img": "^7.0.0"
  }
}
