{
  "name": "@ai-grader/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node --env-file-if-exists=../../.env dist/migrate.js"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
