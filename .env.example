# Local host-development defaults only. Never use these credentials in production.
POSTGRES_USER=grader
POSTGRES_PASSWORD=grader_dev_only
POSTGRES_DB=grader
DATABASE_URL=postgres://grader:grader_dev_only@localhost:5432/grader

# Host-accessible endpoints for applications run directly with npm.
KAFKA_BROKERS=localhost:19092
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-grader-submissions
UPLOAD_SERVICE_URL=http://localhost:3001
RESULTS_SERVICE_URL=http://localhost:3003
GATEWAY_PORT=3000
UPLOAD_PORT=3001
RESULTS_PORT=3003

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only

# Replace before running application features that depend on these values.
JWT_SECRET=local-only-change-this-to-a-random-secret
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=replace-with-an-openrouter-vision-model-id
GRADING_RUBRIC=replace-with-the-rubric-used-for-grading
